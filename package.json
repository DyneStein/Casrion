{
  "name": "casrion",
  "productName": "Casrion",
  "version": "1.0.0",
  "description": "Take notes without leaving what you are reading. A tray app that captures selected text, screenshots, voice memos and drawings into plain Markdown, with a local AI that explains anything you highlight.",
  "author": {
    "name": "DyneStein"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://casrion.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/DyneStein/Casrion.git"
  },
  "bugs": {
    "url": "https://github.com/DyneStein/Casrion/issues"
  },
  "keywords": [
    "notes",
    "markdown",
    "electron",
    "note-taking",
    "screenshot",
    "local-ai",
    "offline",
    "productivity"
  ],
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node dev.cjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist": "vite build && node scripts/obfuscate.cjs && electron-builder --win -c.directories.output=%LOCALAPPDATA%\\casrion-dist",
    "dist:mac": "vite build && node scripts/obfuscate.cjs && electron-builder --mac",
    "build:electron": "vite build && node scripts/obfuscate.cjs && electron-builder --win -c.directories.output=%LOCALAPPDATA%\\casrion-dist"
  },
  "build": {
    "appId": "com.casrion.app",
    "productName": "Casrion",
    "copyright": "Copyright © 2026 Casrion",
    "publish": null,
    "afterPack": "scripts/mac-adhoc-sign.cjs",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      {
        "from": "electron-obf",
        "to": "electron"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**",
      "**/node_modules/selection-hook/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Casrion-Setup-${version}.${ext}",
      "files": [
        "!**/node_modules/@node-llama-cpp/win-x64-cuda/**",
        "!**/node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
        "!**/node_modules/@node-llama-cpp/win-arm64/**",
        "!**/node_modules/selection-hook/prebuilds/darwin-*/**",
        "!**/node_modules/selection-hook/prebuilds/linux-*/**",
        "!**/node_modules/selection-hook/prebuilds/win32-arm64/**"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon_512.png",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "11.0",
      "artifactName": "Casrion-${version}-arm64.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Casrion records voice memos into your notes when you use the voice memo shortcut.",
        "NSAppleEventsUsageDescription": "Casrion asks your browser for the current page address so captured notes can be stamped with the exact page they came from."
      },
      "files": [
        "!**/node_modules/@node-llama-cpp/win-*/**",
        "!**/node_modules/@node-llama-cpp/linux-*/**",
        "!**/node_modules/@node-llama-cpp/mac-x64/**",
        "!**/node_modules/selection-hook/prebuilds/win32-*/**",
        "!**/node_modules/selection-hook/prebuilds/linux-*/**",
        "!**/node_modules/selection-hook/prebuilds/darwin-x64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Casrion",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "node-llama-cpp": "^3.19.0",
    "selection-hook": "^2.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.4.3",
    "lucide-react": "^1.21.0",
    "oxlint": "^1.69.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  }
}
