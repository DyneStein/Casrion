{
  "name": "casrion",
  "productName": "Casrion",
  "version": "1.0.0",
  "description": "Casrion",
  "author": {
    "name": "Casrion"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node dev.cjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist": "vite build && node scripts/obfuscate.cjs && electron-builder --win -c.directories.output=%LOCALAPPDATA%\\casrion-dist",
    "build:electron": "vite build && node scripts/obfuscate.cjs && electron-builder --win -c.directories.output=%LOCALAPPDATA%\\casrion-dist"
  },
  "build": {
    "appId": "com.casrion.app",
    "productName": "Casrion",
    "copyright": "Copyright © 2026 Casrion",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      {
        "from": "electron-obf",
        "to": "electron"
      },
      "!**/node_modules/@node-llama-cpp/win-x64-cuda/**",
      "!**/node_modules/@node-llama-cpp/win-x64-cuda-ext/**",
      "!**/node_modules/@node-llama-cpp/win-arm64/**",
      "!**/node_modules/selection-hook/prebuilds/darwin-*/**",
      "!**/node_modules/selection-hook/prebuilds/linux-*/**",
      "!**/node_modules/selection-hook/prebuilds/win32-arm64/**"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-llama-cpp/**",
      "**/node_modules/@node-llama-cpp/**",
      "**/node_modules/selection-hook/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Casrion-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Casrion",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "marked-katex-extension": "^5.1.10",
    "node-llama-cpp": "^3.19.0",
    "selection-hook": "^2.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.4.3",
    "lucide-react": "^1.21.0",
    "oxlint": "^1.69.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  }
}
